# ── CivicPulse environment template ─────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL 16 DSN ─ asyncpg dialect for runtime
DATABASE_URL=postgresql+asyncpg://civicpulse:secret@localhost:5432/civicpulse

# Alembic uses a *sync* driver (psycopg2) for migrations
DATABASE_SYNC_URL=postgresql+psycopg2://civicpulse:secret@localhost:5432/civicpulse

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# AI Triage configuration
# Supported providers: llm, ollama, rules, simulated
TRIAGE_PROVIDER=rules
# Hosted LLM engine (for TRIAGE_PROVIDER=llm): gemini or groq
LLM_ENGINE=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Redis (Caching & Distributed Rate Limiting)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=30
TRIAGE_CACHE_TTL_SECONDS=86400
